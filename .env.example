# .env.example — Variáveis de Ambiente para a Livraria Digital Cássio Diniz (Vercel)

# 1. BANCO DE DADOS SUPABASE (Autenticação do Administrador, Catálogo e Histórico de Vendas)
# Obtenha gratuitamente em https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua_chave_anon_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta_aqui"

# 2. BANCO DE DADOS EM TEMPO REAL & CONTROLE DE SESSÃO ÚNICA (Upstash Redis)
# Obtenha gratuitamente em https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://seu-banco.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_upstash_aqui"

# 3. GATEWAY DE PAGAMENTO TRANSPARENTE (Mercado Pago ou Asaas)
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-seu-access-token-producao"

# (Opcional - Se preferir Asaas ao invés de Mercado Pago)
# ASAAS_API_KEY="$aact_seu_token_asaas_aqui"

# 4. DISPARO DE E-MAILS TRANSACIONAIS COM O CÓDIGO DE ACESSO (Resend)
# Obtenha gratuitamente em https://resend.com
RESEND_API_KEY="re_seu_token_resend_aqui"
EMAIL_FROM="Livraria Digital Cássio Diniz <ebooks@cassiodiniz.com.br>"
